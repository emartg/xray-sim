---
config:
  layout: elk
  fontFamily: "Segoe UI, Arial, sans-serif"
  theme: base
  themeVariables:
    fontSize: 16px
    lineColor: "#44546a"
    edgeLabelBackground: "#ffffff"
  class:
    useMaxWidth: false
---
%% Module: xray (src/xray, the library XRSim_Xray). Details the blocks Gvxr_Adapter and Xray_Types of architecture_overview. The header of
%% Gvxr_Adapter includes no header of gVirtualXRay or of the Engine (the two OpenGL loaders, GLEW and glad, never meet in one file): the
%% objects of gVirtualXRay are in its private Implementation, and its interface has only the plain types of Xray_Types.h (mm, keV, g/cm3).
classDiagram
    direction LR
    class Gvxr_Adapter {
        <<xray>>
        -implementation : unique_ptr~Implementation~
        +get_version()$ string
        +run_self_check()$ string
        +initialise(beam, detector) string
        +add_mesh(mesh) string
        +update_beam(beam) string
        +update_detector(detector) string
        +set_mesh_transform(index, matrix) string
        +set_mesh_material(index, material) string
        +reset_timings()
        +compute_image(image) string
        +get_is_initialised() bool
        +get_timings() Xray_Timings
    }
    class Implementation {
        <<xray, private>>
        +context : Context
        +detector : XRayDetector
        +beam : XRayBeam
        +renderer : XRayRenderer
        +meshes : vector~PolygonMesh~
        +nodes : vector~SceneGraphNode~
        +width, height : unsigned
        +is_initialised : bool
        +timings : Xray_Timings
    }
    class Xray_Material {
        <<xray type>>
        +compound : string
        +density : double
    }
    class Xray_Mesh {
        <<xray type>>
        +name : string
        +positions : vector~float~
        +indices : vector~uint32_t~
        +material : Xray_Material
    }
    class Xray_Beam {
        <<xray type>>
        +source_position : array~double, 3~
        +energy : double
        +photons_per_pixel : double
    }
    class Xray_Detector {
        <<xray type>>
        +position : array~double, 3~
        +up_vector : array~double, 3~
        +width_in_pixels, height_in_pixels : unsigned
        +pixel_size : double
    }
    class Xray_Image {
        <<xray type>>
        +width, height : unsigned
        +pixels : vector~float~
    }
    class Xray_Timings {
        <<xray type>>
        +guard_ms, initialise_ms, glew_ms : double
        +renderer_initialise_ms, add_meshes_ms : double
        +update_ms, computation_ms, read_back_ms : double
        +mesh_count : unsigned
    }
    class gVirtualXRay {
        <<gVXR>>
        Context: adoptCurrentContext(), release()
        XRayDetector: setXrayPointSource(), setDetectorPosition()
        XRayDetector: setUpVector(), setNumberOfPixels()
        XRayDetector: setResolutionInUnitsOfLengthPerPixel()
        XRayBeam: clear(), addChannelPerPixelAtSDD()
        XRayRenderer: initialise(), addInnerSurface()
        XRayRenderer: needUpdateSurfacePerMaterial()
        XRayRenderer: computeImage(), getFBO(), isReady()
        XRayRenderer: enableArtifactFilteringOnGPU(), release()
        PolygonMesh: setInternalData(), setCompound(), setDensity()
        SceneGraphNode: setGeometry(), setLocalTransformation()
    }

    Gvxr_Adapter *-- Implementation : owns
    Gvxr_Adapter ..> Xray_Mesh : add_mesh
    Gvxr_Adapter ..> Xray_Beam : initialise, update_beam
    Gvxr_Adapter ..> Xray_Detector : initialise, update_detector
    Gvxr_Adapter ..> Xray_Image : compute_image
    Xray_Mesh *-- Xray_Material : material
    Implementation *-- Xray_Timings : timings
    Implementation *-- gVirtualXRay : context, detector, beam, renderer, a mesh and a node per mesh
